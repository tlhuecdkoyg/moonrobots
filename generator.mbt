///|
fn normalize_origin(origin : String) -> String {
  let trimmed = origin.trim().to_owned()
  let mut end = trimmed.length()
  while end > 0 && trimmed.get_char(end - 1) == Some('/') {
    end = end - 1
  }
  trimmed[:end].to_owned()
}

///|
fn normalized_generated_path(path : String) -> String {
  let value = path.trim().to_owned()
  if value.is_empty() {
    ""
  } else if value.has_prefix("/") || value.has_prefix("*") {
    value
  } else {
    "/" + value
  }
}

///|
fn push_generator_warning(warnings : Array[String], message : String) -> Unit {
  if !warnings.contains(message) {
    warnings.push(message)
  }
}

///|
fn validate_origin(origin : String, warnings : Array[String]) -> Unit {
  if origin.is_empty() {
    push_generator_warning(
      warnings, "Site origin is empty; relative sitemap paths cannot be made absolute.",
    )
  } else if !(origin.has_prefix("https://") || origin.has_prefix("http://")) {
    push_generator_warning(
      warnings, "Site origin should begin with https:// or http://.",
    )
  } else if origin.has_prefix("http://") {
    push_generator_warning(
      warnings, "Consider using HTTPS for the site origin and sitemap URLs.",
    )
  }
}

///|
fn validate_agent_group(
  group : GeneratedAgentGroup,
  warnings : Array[String],
) -> Unit {
  if group.agents.length() == 0 {
    push_generator_warning(
      warnings, "A generated crawler group has no product tokens and will be omitted.",
    )
  }
  for agent in group.agents {
    if !valid_product_token(agent) {
      push_generator_warning(
        warnings,
        "Invalid product token '\{agent}' will be omitted from generated output.",
      )
    }
  }
  if group.allow_paths.length() > 0 && group.disallow_paths.length() == 0 {
    push_generator_warning(
      warnings, "An agent group contains Allow rules without Disallow rules; confirm they are useful.",
    )
  }
}

///|
fn write_header(output : StringBuilder, config : GeneratorConfig) -> Unit {
  if config.include_header {
    output.write_string("# robots.txt generated by MoonRobots Studio\n")
    if !config.project_name.trim().to_owned().is_empty() {
      output.write_string("# Project: \{config.project_name.trim()}\n")
    }
    output.write_string(
      "# Review this policy before deploying it to production.\n\n",
    )
  }
}

///|
fn write_generated_rule(
  output : StringBuilder,
  kind : RuleKind,
  path : String,
  seen : Array[String],
) -> Bool {
  let normalized = normalized_generated_path(path)
  if normalized.is_empty() {
    return false
  }
  let name = if kind == Allow { "Allow" } else { "Disallow" }
  let key = "\{name}:\{normalized}"
  if seen.contains(key) {
    return false
  }
  seen.push(key)
  output.write_string("\{name}: \{normalized}\n")
  true
}

///|
fn write_generated_group(
  output : StringBuilder,
  group : GeneratedAgentGroup,
  include_guidance : Bool,
) -> (Bool, Int) {
  let agents : Array[String] = []
  for agent in group.agents {
    if valid_product_token(agent) && !agents.contains(agent.to_lower()) {
      agents.push(agent.to_lower())
    }
  }
  if agents.length() == 0 {
    return (false, 0)
  }
  if include_guidance {
    output.write_string("# Policy for ")
    for index, agent in agents {
      if index > 0 {
        output.write_string(", ")
      }
      output.write_string(agent)
    }
    output.write_char('\n')
  }
  for agent in agents {
    output.write_string("User-agent: \{agent}\n")
  }
  let seen : Array[String] = []
  let mut rules = 0
  for path in group.disallow_paths {
    if write_generated_rule(output, Disallow, path, seen) {
      rules = rules + 1
    }
  }
  for path in group.allow_paths {
    if write_generated_rule(output, Allow, path, seen) {
      rules = rules + 1
    }
  }
  if rules == 0 {
    output.write_string("Disallow:\n")
  }
  (true, rules)
}

///|
fn absolute_sitemap(origin : String, path : String) -> String {
  let value = path.trim().to_owned()
  if value.has_prefix("https://") || value.has_prefix("http://") {
    value
  } else if origin.is_empty() {
    value
  } else if value.has_prefix("/") {
    origin + value
  } else {
    origin + "/" + value
  }
}

///|
/// Generate normalized robots.txt text from a declarative configuration.
pub fn generate_policy(config : GeneratorConfig) -> GeneratedPolicy {
  let warnings : Array[String] = []
  let origin = normalize_origin(config.site_origin)
  validate_origin(origin, warnings)
  for group in config.agent_groups {
    validate_agent_group(group, warnings)
  }
  let output = StringBuilder::new()
  write_header(output, config)
  let default_group : GeneratedAgentGroup = {
    agents: ["*"],
    disallow_paths: config.default_disallow_paths,
    allow_paths: config.default_allow_paths,
  }
  let (_, default_rules) = write_generated_group(
    output,
    default_group,
    config.include_guidance,
  )
  let mut groups = 1
  let mut rules = default_rules
  for group in config.agent_groups {
    output.write_char('\n')
    let (written, group_rules) = write_generated_group(
      output,
      group,
      config.include_guidance,
    )
    if written {
      groups = groups + 1
      rules = rules + group_rules
    }
  }
  let seen_sitemaps : Array[String] = []
  let mut sitemap_count = 0
  for path in config.sitemap_paths {
    let sitemap = absolute_sitemap(origin, path)
    if !sitemap.is_empty() && !seen_sitemaps.contains(sitemap) {
      if sitemap_count == 0 {
        output.write_char('\n')
      }
      output.write_string("Sitemap: \{sitemap}\n")
      seen_sitemaps.push(sitemap)
      sitemap_count = sitemap_count + 1
    }
  }
  let source = output.to_string()
  let parsed = parse(source)
  if parsed.diagnostics.length() > 0 {
    push_generator_warning(
      warnings, "Generated output contains parser diagnostics; inspect invalid product tokens or paths.",
    )
  }
  { source, warnings, rule_count: rules, group_count: groups, sitemap_count }
}

///|
/// Return a practical starter configuration for a common site profile.
pub fn generator_preset(name : String, site_origin : String) -> GeneratorConfig {
  match name.to_lower() {
    "blog" =>
      {
        site_origin,
        project_name: "Content site",
        default_disallow_paths: ["/admin/", "/drafts/", "/search"],
        default_allow_paths: ["/drafts/public-preview/"],
        agent_groups: [],
        sitemap_paths: ["/sitemap.xml"],
        include_header: true,
        include_guidance: true,
      }
    "commerce" =>
      {
        site_origin,
        project_name: "Commerce site",
        default_disallow_paths: [
          "/account/", "/cart/", "/checkout/", "/internal-search", "/*?sort=", "/*?filter=",
        ],
        default_allow_paths: ["/products/", "/categories/"],
        agent_groups: [],
        sitemap_paths: ["/sitemap-products.xml", "/sitemap-pages.xml"],
        include_header: true,
        include_guidance: true,
      }
    "documentation" =>
      {
        site_origin,
        project_name: "Documentation site",
        default_disallow_paths: ["/internal/", "/preview/", "/api/private/"],
        default_allow_paths: ["/", "/api/public/"],
        agent_groups: [],
        sitemap_paths: ["/sitemap.xml"],
        include_header: true,
        include_guidance: true,
      }
    "private" =>
      {
        site_origin,
        project_name: "Private site",
        default_disallow_paths: ["/"],
        default_allow_paths: [],
        agent_groups: [],
        sitemap_paths: [],
        include_header: true,
        include_guidance: true,
      }
    _ =>
      {
        site_origin,
        project_name: "Website",
        default_disallow_paths: [],
        default_allow_paths: [],
        agent_groups: [],
        sitemap_paths: ["/sitemap.xml"],
        include_header: true,
        include_guidance: true,
      }
  }
}

///|
/// Explain generator warnings and output statistics in Markdown.
pub fn generated_policy_to_markdown(policy : GeneratedPolicy) -> String {
  let output = StringBuilder::new()
  output.write_string("# Generated robots.txt\n\n")
  output.write_string("- Groups: \{policy.group_count}\n")
  output.write_string("- Rules: \{policy.rule_count}\n")
  output.write_string("- Sitemaps: \{policy.sitemap_count}\n")
  output.write_string("- Warnings: \{policy.warnings.length()}\n\n")
  if policy.warnings.length() > 0 {
    output.write_string("## Review warnings\n\n")
    for warning in policy.warnings {
      output.write_string("- \{warning}\n")
    }
    output.write_char('\n')
  }
  output.write_string("## Output\n\n```text\n")
  output.write_string(policy.source)
  output.write_string("```\n")
  output.to_string()
}
